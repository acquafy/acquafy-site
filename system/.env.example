# Server-only Supabase connection. Run npm run supabase:env after starting local Supabase.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=

# Investor onboarding and Stripe Checkout (server only; never prefix these with NEXT_PUBLIC_).
# Use keys from the same Supabase project/environment as SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENVIRONMENT=test
# Canonical public website origin, with no /app path, for private invites and Checkout returns.
PORTAL_PUBLIC_ORIGIN=
# Live mode requires its own keys, endpoint, reviewed terms and an explicit enablement:
# STRIPE_ENVIRONMENT=live
# STRIPE_LIVE_APPROVED=true

# ParceladoUSA (optional): the balance of a BRL order can be paid in installments. Credentials from the
# ParceladoUSA merchant panel. Its callback is <origin>/app/api/orders/parceladousa/<payment id>, set per order.
# PARCELADOUSA_PUBLIC_KEY=
# PARCELADOUSA_MERCHANT_CODE=
# Webhook token (whsec_…) of the API key; set the key's webhook to <origin>/app/api/orders/parceladousa.
# PARCELADOUSA_WEBHOOK_SECRET=
# PARCELADOUSA_ENVIRONMENT=sandbox

# Order e-mails (Amazon SES, API v2). IAM user allowed only ses:SendEmail on the verified acquafy.com identity.
# ORDER_EMAIL_FROM must be an address on that domain. Without these, e-mails wait in the outbox.
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# ORDER_EMAIL_FROM=Acquafy <pedidos@acquafy.com>
# Vercel Cron sends it as "Authorization: Bearer" to /app/api/orders/notifications.
# CRON_SECRET=
