{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build:site"
    },
    "portal": {
      "root": "system",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": { "service": "portal" } },
    { "source": "/app/(.*)", "destination": { "service": "portal" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
